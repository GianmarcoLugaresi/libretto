{
  "name": "mysapienza",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/make-icons.mjs",
    "ipa": "npm run build && npx cap sync ios && bash scripts/make-ipa.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && tsc -p pipeline/tsconfig.json",
    "pipeline": "tsx pipeline/src/esegui.ts",
    "pipeline:secco": "tsx pipeline/src/esegui.ts --secco"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.2.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
